# Rules specific to THIS repo only.
#
# Machine-wide rules live in .config/git/ignore, which git reads as the XDG
# global excludes file. This file used to be pointed at by core.excludesfile,
# which meant every rule below applied to every repo on the machine — including
# the .claude/ rules, which silently broke staging in dotfiles-private.

.gitconfig
packer_compiled.lua
*.ttf
follower.json
username.json

.config/1Password/
.config/autostart/
.config/com.tolaria.app/
.config/gem/
.config/gh/hosts.yml
.config/github-copilot/
.config/gpt4all.io/
.config/gtk-2.0/
.config/karabiner/automatic_backups/
.config/op/
.config/uv/
.config/zed/prompts/

# .claude is a live Claude Code state dir — ignore everything, re-include by hand.
# Must be `.claude/*`, not `.claude/`: git cannot re-include a file whose parent
# directory is excluded, which silently killed every negation below.
# CLAUDE.md is deliberately absent — it lives in dotfiles-private (this repo is public).
.claude/*
!.claude/settings.json
!.claude/statusline.sh
