#!/usr/bin/env bash
#?tool shell  this index — every custom key, alias and script, searchable
# cheat — one searchable index of everything custom in these dotfiles.
#
# The note lives on the line it describes, so there is no second file to keep in
# sync: annotate a binding, alias or script with a `#?` comment and it appears
# here. Two forms, both optional-group-first:
#
#   bind C-r display-popup ...   #? restore  pull back a closed window
#   #? git  recent branches
#   alias gb="git branch ..."
#   #?tool restore  put a whole workspace back      (anywhere in an executable)
#
# The group may carry the key when the definition cannot spell it: `#? git:gst
# status, short` lists it under `gst`, and quotes hold a key that has a space in
# it — `#? restore:"tmux-restore list"  what the snapshot holds`.
#
# The key you actually press or type is derived from the definition itself —
# tmux bindings resolve their prefix, aliases and functions give their name, and
# a `#?tool` line names its own file. Claude commands and skills need no
# annotation; they already carry a description.
#
# tmux's own bindings and commands come along too, read out of tmux rather than
# copied here. They are reference, not memory-jog, so they stay out of the bare
# table and surface on a search, in the picker, or under `cheat --tmux`.
#
# Usage:
#   cheat                grouped table, your own bindings only
#   cheat <term>         filter on key, group or description, tmux defaults included
#   cheat --tmux         everything tmux: yours, the defaults, the shell commands
#   cheat -i             fzf picker, Enter copies the key
#   cheat --new [days]   what you added lately, straight from git (default 30)

set -uo pipefail

# Byte order, so the table lands the same way on every machine and `prefix /`
# does not sort ahead of `prefix D` on one and behind it on the next.
export LC_ALL=C

CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"

# Resolve through symlinks without relying on GNU readlink: every dotfile here
# is a symlink into a repo, and git needs the real path to have any history.
resolve() {
    local p=$1 dir base
    dir=$(dirname "$p")
    base=$(basename "$p")
    while [ -L "$p" ]; do
        p=$(readlink "$p")
        case "$p" in
            /*) ;;
            *) p="$dir/$p" ;;
        esac
        dir=$(dirname "$p")
        base=$(basename "$p")
    done
    printf '%s/%s\n' "$(cd "$dir" 2>/dev/null && pwd -P)" "$base"
}

sources() {
    local f
    for f in \
        "$HOME/.tmux.conf" \
        "$HOME/.zshrc" \
        "$HOME/.gitconfig" \
        "$HOME"/.config/tmux/scripts/*.sh \
        "$HOME"/.config/launchd/scripts/* \
        "$HOME"/.local/bin/* \
        "$CLAUDE_DIR"/hooks/*.sh \
        "$CLAUDE_DIR"/statusline.sh
    do
        # Globs that match nothing come back literal, and ~/.local/bin holds
        # directories and installed binaries next to the scripts — awk chokes
        # on those, so let grep -I decide what counts as text.
        [ -f "$f" ] || continue
        grep -Iq . "$f" 2>/dev/null || continue
        printf '%s\n' "$f"
    done
}

# Emits: key \t group \t description \t source:line
parse_file() {
    awk -v src="$1" '
    function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }

    # What you press or type, read out of the definition line itself.
    function derive(line,   s, k, prefixed, m) {
        s = trim(line)
        if (s ~ /^(bind|bind-key)[ \t]/) {
            sub(/^(bind|bind-key)[ \t]+/, "", s)
            prefixed = 1
            while (s ~ /^-/) {
                # -T <table> takes an argument; every other flag stands alone.
                if (s ~ /^-T[ \t]/) {
                    sub(/^-T[ \t]+[^ \t]+[ \t]+/, "", s)
                } else {
                    if (s ~ /^-[a-zA-Z]*n/) prefixed = 0
                    sub(/^-[^ \t]+[ \t]+/, "", s)
                }
            }
            k = s
            sub(/[ \t].*$/, "", k)
            gsub(/^['"'"'"]|['"'"'"]$/, "", k)
            return prefixed ? "prefix " k : k
        }
        if (s ~ /^alias[ \t]/) {
            sub(/^alias[ \t]+/, "", s)
            k = s
            sub(/=.*$/, "", k)
            return trim(k)
        }
        if (match(s, /^(function[ \t]+)?[A-Za-z0-9_.-]+[ \t]*\(\)/)) {
            k = substr(s, RSTART, RLENGTH)
            sub(/^function[ \t]+/, "", k)
            sub(/[ \t]*\(\).*$/, "", k)
            return k
        }
        # zsh takes `function name {` without the parens too.
        if (match(s, /^function[ \t]+[A-Za-z0-9_.-]+/)) {
            k = substr(s, RSTART, RLENGTH)
            sub(/^function[ \t]+/, "", k)
            return k
        }
        # A tunable is worth listing under the option you set.
        if (match(s, /@[A-Za-z0-9_-]+/)) {
            if (s ~ /^set/) return substr(s, RSTART, RLENGTH)
        }
        k = s
        sub(/[ \t].*$/, "", k)
        return k
    }

    function emit(key, rest, line,   group, desc, override) {
        rest = trim(rest)
        # `group:"key with spaces"` — the group token is otherwise cut at the
        # first space, which is one word short of any subcommand: an override of
        # `tmux-restore list` arrives as the key `tmux-restore` and a
        # description starting `list`. Quotes are the only way to say the two
        # words are one key.
        if (match(rest, /^[A-Za-z0-9_-]+:"[^"]*"/)) {
            group = substr(rest, 1, RLENGTH)
            desc = trim(substr(rest, RLENGTH + 1))
        } else {
            group = rest
            sub(/[ \t].*$/, "", group)
            desc = trim(substr(rest, length(group) + 1))
        }
        if (desc == "") { desc = group; group = "misc" }
        # `group:key` spells out the keystroke when the definition cannot: an
        # option that turns a whole mode on says nothing about what you press.
        if (match(group, /:/)) {
            override = substr(group, RSTART + 1)
            group = substr(group, 1, RSTART - 1)
            gsub(/^"|"$/, "", override)
            if (override != "") key = override
        }
        printf "%s\t%s\t%s\t%s:%d\n", key, group, desc, src, line
    }

    # Form 3: file-level, names its own file.
    /^[ \t]*#\?tool[ \t]/ {
        rest = $0
        sub(/^[ \t]*#\?tool[ \t]+/, "", rest)
        n = split(src, parts, "/")
        emit(parts[n], rest, NR)
        next
    }

    # Form 2: standalone note, described by the next real line of code.
    /^[ \t]*#\?[ \t]/ {
        pending = $0
        sub(/^[ \t]*#\?[ \t]+/, "", pending)
        pending_line = NR
        next
    }

    # Form 1: trailing note on the definition itself.
    /#\?[ \t]/ && !/^[ \t]*#/ {
        idx = index($0, "#?")
        code = substr($0, 1, idx - 1)
        rest = substr($0, idx + 2)
        emit(derive(code), rest, NR)
        pending = ""
        next
    }

    {
        if (pending != "" && trim($0) != "" && $0 !~ /^[ \t]*#/) {
            emit(derive($0), pending, pending_line)
            pending = ""
        }
    }
    ' "$1"
}

# Claude commands and skills document themselves in frontmatter — annotating
# them would be transcribing, and half of them live in other repos anyway.
parse_claude() {
    local f name desc
    for f in "$CLAUDE_DIR"/commands/*.md; do
        [ -f "$f" ] || continue
        name=$(basename "$f" .md)
        desc=$(frontmatter_desc "$f")
        [ -n "$desc" ] || desc=$(sed -n '/^[^#-]/{s/^ *//;p;q;}' "$f")
        printf '/%s\tclaude\t%s\t%s:1\n' "$name" "$(clip "$desc")" "$f"
    done
    for f in "$CLAUDE_DIR"/skills/*/SKILL.md; do
        [ -f "$f" ] || continue
        name=$(basename "$(dirname "$f")")
        printf '/%s\tskill\t%s\t%s:1\n' "$name" "$(clip "$(frontmatter_desc "$f")")" "$f"
    done
}

# `description:` is as often a folded block as a one-liner, and a bare `>` for a
# description is worse than none at all.
frontmatter_desc() {
    awk '
        NR == 1 && $0 == "---" { fm = 1; next }
        fm && $0 == "---" { exit }
        !fm { exit }
        /^description:/ {
            sub(/^description:[ \t]*/, "")
            if ($0 == ">" || $0 == ">-" || $0 == "|" || $0 == "|-") { fold = 1; next }
            print; exit
        }
        fold {
            if ($0 ~ /^[A-Za-z_-]+:/) exit
            sub(/^[ \t]+/, "")
            printf "%s ", $0
        }
        END { if (fold) print "" }
    ' "$1"
}

# tmux carries a note on every default binding, so `list-keys -N` is the list —
# resolved against the live prefix, and already missing anything you rebound,
# since your own `bind` drops the note along with the default. Nothing to keep
# in sync, and it costs about five milliseconds.
parse_tmux_keys() {
    command -v tmux >/dev/null 2>&1 || return 0
    local prefix
    prefix=$(tmux show-options -gv prefix 2>/dev/null)
    [ -n "$prefix" ] || prefix=C-b
    tmux list-keys -N 2>/dev/null | awk -v pfx="$prefix" '
    function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
    {
        s = $0
        # A prefixed binding reads as two tokens here, `C-a M-Left`, and says
        # more as `prefix M-Left` — the same shape the annotated bindings take.
        if (substr(s, 1, length(pfx) + 1) == pfx " ") {
            s = trim(substr(s, length(pfx) + 2))
            lead = "prefix "
        } else {
            lead = ""
        }
        key = s
        sub(/[ \t].*$/, "", key)
        desc = trim(substr(s, length(key) + 1))
        # tmux writes its notes as sentences; the rest of the table does not.
        desc = tolower(substr(desc, 1, 1)) substr(desc, 2)
        if (desc == "") next
        # Ten rows to say the digits pick a window is ten rows of nothing.
        if (key ~ /^[0-9]$/ && desc ~ /^select window [0-9]$/) {
            if (digits++) next
            key = "0-9"
            desc = "select a window by number"
        }
        printf "%s%s\ttmux-default\t%s\ttmux list-keys -N:0\n", lead, key, desc
    }'
}

# Every command tmux knows, its alias and its flags. No prose — tmux does not
# ship any — but the names carry themselves, and a signature is the part you
# actually go looking for: `move-window` is easy to remember, `-s` and `-t` and
# which of them takes the destination is not.
parse_tmux_cmds() {
    command -v tmux >/dev/null 2>&1 || return 0
    tmux list-commands 2>/dev/null | awk '
    function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
    {
        name = $1
        rest = trim(substr($0, length(name) + 1))
        # `move-window (movew) [-abdkr] ...` — most commands have a short alias,
        # some have none, and a few take no arguments at all.
        if (substr(rest, 1, 1) == "(") {
            close_paren = index(rest, ")")
            alias = substr(rest, 2, close_paren - 2)
            rest = trim(substr(rest, close_paren + 1))
        } else {
            alias = ""
        }
        if (alias != "" && rest != "") desc = alias "  " rest
        else if (alias != "") desc = alias
        else if (rest != "") desc = rest
        else desc = "no arguments"
        # The long ones run past any terminal; `man tmux` is where the full
        # story lives anyway.
        if (length(desc) > 96) desc = substr(desc, 1, 95) "…"
        printf "%s\ttmux-cmd\t%s\ttmux list-commands:0\n", name, desc
    }'
}

# The shell side has no notes either, and the signature alone does not say why
# you would reach for one. These are the handful worth knowing by heart.
parse_tmux_cli() {
    while IFS='|' read -r key desc; do
        [ -n "$key" ] || continue
        printf '%s\ttmux-cli\t%s\ttmux:0\n' "$key" "$desc"
    done <<'EOF'
tmux new -s NAME|start a named session
tmux new -ds NAME|start one in the background, without attaching
tmux a|attach to the session you used last
tmux a -t NAME|attach to a named session
tmux switch-client -t NAME|move this client to another session, without detaching
tmux ls|list sessions, with window counts
tmux kill-session -t NAME|end one session
tmux kill-server|end every session at once
tmux rename-session NAME|rename the current session
tmux source ~/.tmux.conf|reload the config without restarting
tmux list-keys -N|every binding with its description
tmux list-panes -a|every pane in every session, with its index
tmux send-keys -t T KEYS|type into another pane
tmux capture-pane -pt T|dump another pane's contents to stdout
tmux display -p '#{...}'|print a format string for the current pane
tmux show-options -g|every server option and its value
EOF
}

clip() {
    printf '%s' "$1" | tr '\n' ' ' | cut -c1-96 | sed 's/ *$//'
}

collect() {
    local f
    while IFS= read -r f; do
        parse_file "$f"
    done < <(sources)
    parse_claude
    if [ "${WITH_TMUX:-0}" = 1 ]; then
        parse_tmux_keys
        parse_tmux_cli
        parse_tmux_cmds
    fi
}

# Group first, then key, so the table reads as sections.
render() {
    sort -t$'\t' -k2,2 -k1,1 | awk -F'\t' '
    BEGIN {
        bold  = "\033[1m"; dim = "\033[2m"; off = "\033[0m"
        key_c = "\033[36m"; grp_c = "\033[35;1m"
    }
    { k[NR] = $1; g[NR] = $2; d[NR] = $3
      if (length($1) > w) w = length($1) }
    END {
        if (NR == 0) { print "no matches"; exit 1 }
        for (i = 1; i <= NR; i++) {
            if (g[i] != last) {
                if (last != "") printf "\n"
                printf "%s%s%s\n", grp_c, g[i], off
                last = g[i]
            }
            printf "  %s%-*s%s  %s\n", key_c, w, k[i], off, d[i]
        }
    }'
}

case "${1-}" in
    -i|--interactive)
        command -v fzf >/dev/null 2>&1 || { echo "cheat -i needs fzf" >&2; exit 1; }
        WITH_TMUX=1
        # Two tab-separated fields: what fzf shows, and the raw key plus source
        # it hands back. Keeping the key out of the display column means the
        # padding never ends up on the clipboard.
        pick=$(collect | sort -t$'\t' -k2,2 -k1,1 | awk -F'\t' '
            { printf "%-22s %-9s %s\t%s\t%s\n", $1, $2, $3, $1, $4 }' |
            fzf --with-nth=1 --delimiter='\t' \
                --prompt='cheat > ' \
                --preview='echo {3}' --preview-window=down,1 \
                --header='enter copies the key')
        [ -n "$pick" ] || exit 0
        key=$(printf '%s' "$pick" | cut -f2)
        printf '%s' "$key" | pbcopy 2>/dev/null
        printf '%s\n' "$key"
        ;;
    --new)
        days=${2:-30}
        # Ask each repo that backs a source what it learned lately. Added `#?`
        # lines are exactly the things you built and have not used enough to
        # remember yet. The whole repo is in scope, not just the files above:
        # an annotation in a script this list does not reach is still news.
        roots=$(while IFS= read -r f; do
                    real=$(resolve "$f")
                    git -C "$(dirname "$real")" rev-parse --show-toplevel 2>/dev/null
                done < <(sources) | sort -u)
        old_ifs=$IFS
        IFS=$'\n'
        fresh=$(for root in $roots; do
                    IFS=$old_ifs
                    git -C "$root" log --since="$days days ago" -p --unified=0 2>/dev/null |
                        grep -E '^\+.*#\?[a-z]*[[:space:]]' |
                        sed -E 's/.*#\?(tool)?[[:space:]]+//' |
                        sed -E 's/^[^[:space:]]+[[:space:]]+//'
                    IFS=$'\n'
                done | sort -u)
        IFS=$old_ifs
        [ -n "$fresh" ] || { echo "nothing annotated in the last $days days"; exit 0; }
        # Match the added notes back onto the index rather than printing the
        # diff: the annotation carries the description, but the key lives on the
        # definition line, which for a standalone note is not even in the hunk.
        collect | awk -F'\t' 'NR == FNR { new[$0] = 1; next } ($3 in new)' \
            <(printf '%s\n' "$fresh") - | render
        ;;
    --greet)
        # A shell greeting has to cost nothing: --new walks the history of three
        # repos and takes the best part of a second, so print yesterday's answer
        # and refresh behind the prompt. Same trade as the statusline.
        cache="${XDG_CACHE_HOME:-$HOME/.cache}/cheat-new"
        mkdir -p "$(dirname "$cache")"
        [ -s "$cache" ] && {
            printf '\033[2mbuilt lately — `cheat` for the whole list\033[0m\n'
            cat "$cache"
            printf '\n'
        }
        if [ ! -f "$cache" ] || [ -n "$(find "$cache" -mmin +720 2>/dev/null)" ]; then
            (
                out=$("$0" --new "${2:-14}" 2>/dev/null)
                case "$out" in
                    nothing\ annotated*|"") : > "$cache" ;;
                    *) printf '%s\n' "$out" > "$cache" ;;
                esac
            ) >/dev/null 2>&1 &
        fi
        ;;
    --tmux)
        # Your bindings, tmux's own, and the shell side, in one table: the three
        # groups sort together and read as one section per source.
        WITH_TMUX=1
        collect | awk -F'\t' '$2 ~ /^tmux/' | render
        ;;
    -h|--help)
        sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    "")
        collect | render
        ;;
    *)
        WITH_TMUX=1
        collect | grep -i -- "$1" | render
        ;;
esac
