#!/usr/bin/env python3
"""PTY wrapper for Claude Code: recolor transcript styles.

Claude Code strips ANSI from model text and renders markdown with a mostly
monochrome theme (bold headers/labels, blue inline code). This wrapper sits
between the terminal and claude, rewriting the SGR style sequences claude
emits so structural styles get distinct colors. Sequences where claude sets
an explicit color itself (diffs, fence syntax highlighting, UI chrome) are
left untouched.

Defaults (Jordi's mixer picks, 2026-08-05):
    bold      -> green 0x4ed470           (headers, labels, verdicts)
    italic    -> slate 0x62839d           (asides, blockquotes)
    underline -> azure 0x0cb1ed           (links)
    quotebold -> inherit                  (bold nested inside a blockquote)

Bold means two different things depending on where it lands: a heading when it
stands alone, plain emphasis when it sits inside a quoted passage. Colouring
both the same scatters heading-green mid-sentence through every quote, so the
translator tracks whether an italic run is open and colours nested bold with
quotebold instead — "inherit" keeps it in the quote's own colour.

Config, in priority order:
    ~/.config/claude-color.conf     bold=78;212;112   (live-reloaded!)
    CLAUDE_COLOR_BOLD / _ITALIC / _UNDERLINE / _QUOTEBOLD env vars
    built-in defaults above

Color specs: 256-color index ("114"), truecolor ("r;g;b"), "off", or for
quotebold "inherit".

The config file is watched while running: edit it (or use --set) and every
open claude-color session recolors within a second — no restart. Only newly
drawn output changes; text already on screen keeps its old colors.

    claude-color --tune                                # interactive tuner
    claude-color --schemes                             # curated four-colour sets
    claude-color --scheme ember                        # apply one of them
    claude-color --set bold="78;212;112" italic=off    # write config live
    claude-color --palette                             # numbered 256 chart

A nested style that ends inside an open quote restores the quote colour rather
than the default foreground, so bold or a link mid-quote no longer punches a
hole in it. Outside a quote the old behaviour stands: style-off drops to the
default foreground so a colour cannot leak.

Usage: claude-color [claude args...]        (defaults to plain `claude`)
"""

import fcntl
import os
import pty
import re
import select
import signal
import sys
import termios
import time
import tty

CONFIG = os.path.expanduser("~/.config/claude-color.conf")

STYLES = [
    # (name, env var, default spec, on code, off code)
    ("bold", "CLAUDE_COLOR_BOLD", "78;212;112", b"1", b"22"),
    ("italic", "CLAUDE_COLOR_ITALIC", "98;131;157", b"3", b"23"),
    ("underline", "CLAUDE_COLOR_UNDERLINE", "12;177;237", b"4", b"24"),
]

# Bold nested inside italic is emphasis inside a quoted passage, not a heading.
# Painting it the heading colour scatters heading-green through the middle of
# quoted sentences, which reads as confetti. Default "inherit" leaves the colour
# alone so the word only gains weight and stays in the quote's own colour; set
# quotebold=<spec> to give nested emphasis a colour of its own.
NESTED = ("quotebold", "CLAUDE_COLOR_QUOTEBOLD", "inherit")

PARTIAL = re.compile(rb"\x1b(\[[0-9;]*)?$")
SGR = re.compile(rb"\x1b\[([0-9;]*)m")

# A terminal hyperlink carries no style of its own: OSC 8 makes the text
# clickable and says nothing about how it should look, so a link Claude Code
# emits arrives with no SGR attached and the underline rule never fires on it.
# Matching the sequence itself is the only way to see one.
#   open:  ESC ] 8 ; params ; URI  ST        close: ESC ] 8 ; ; ST
OSC8 = re.compile(rb"\x1b\]8;[^;\x1b\x07]*;([^\x1b\x07]*)(?:\x1b\\|\x07)")
TOKEN = re.compile(OSC8.pattern + rb"|\x1b\[([0-9;]*)m")
ST = re.compile(rb"\x1b\\|\x07")

STYLE_ON = {on: name for name, _, _, on, _ in STYLES}
STYLE_OFF = {off: name for name, _, _, _, off in STYLES}


def parse_spec(name, spec):
    """Turn '114' / '255;100;0' / 'off' into an SGR color fragment or None."""
    s = spec.strip().strip('"').strip("'").lower()
    if s in ("off", "none", "inherit", ""):
        return None
    if re.fullmatch(r"\d{1,3}", s):
        return b"38;5;" + s.encode()
    match = re.fullmatch(r"(\d{1,3})[;,](\d{1,3})[;,](\d{1,3})", s)
    if match:
        return b"38;2;" + ";".join(match.groups()).encode()
    raise ValueError(f"bad {name} color spec {spec!r} "
                     "(use a 256-color index, r;g;b, or 'off')")


def read_config():
    cfg = {}
    try:
        with open(CONFIG) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, _, value = line.partition("=")
                cfg[key.strip().lower()] = value.strip()
    except OSError:
        pass
    return cfg


def build_colors():
    """Resolve every configured spec to an SGR fragment, or None to leave alone."""
    cfg = read_config()
    colors = {}
    for name, env, default, _, _ in STYLES:
        colors[name] = parse_spec(name, cfg.get(name, os.environ.get(env, default)))

    name, env, default = NESTED
    colors[name] = parse_spec(name, cfg.get(name, os.environ.get(env, default)))

    return colors


def config_mtime():
    try:
        return os.stat(CONFIG).st_mtime
    except OSError:
        return None


def write_config(cfg):
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    with open(CONFIG, "w") as f:
        f.write("# claude-color — live-reloaded by running sessions\n")
        for key, value in cfg.items():
            f.write(f"{key}={value}\n")


def cmd_set(pairs):
    valid = {name for name, *_ in STYLES} | {NESTED[0]}
    cfg = read_config()
    for pair in pairs:
        key, sep, value = pair.partition("=")
        key = key.strip().lower()
        if not sep or key not in valid:
            sys.exit(f"claude-color: expected {'/'.join(sorted(valid))}=<spec>, got {pair!r}")
        parse_spec(key, value)  # validate before writing
        cfg[key] = value.strip().strip('"').strip("'")
    write_config(cfg)
    print(f"wrote {CONFIG}")
    for key, value in cfg.items():
        print(f"  {key}={value}")
    print("open claude-color sessions pick this up within a second")


def print_palette():
    out = []
    for i in range(256):
        out.append(f"\x1b[38;5;{i}m{i:>4}\x1b[0m")
        if i % 12 == 11:
            out.append("\n")
    out.append("\n")
    for name, _, default, _, _ in STYLES:
        out.append(f"{name}={default} (built-in default)\n")
    out.append(f"{NESTED[0]}={NESTED[2]} (built-in default)\n")
    out.append('Apply live: claude-color --set bold="r;g;b"\n')
    sys.stdout.write("".join(out))


# ---------------------------------------------------------------- live tuner

# curses cannot express 24-bit colour and every spec here is truecolor, so the
# tuner drives the terminal directly: alternate screen in, raw keys, full
# redraw per keystroke. Small enough that a diff of the frame would cost more
# than just repainting it.

ALT_IN = "\x1b[?1049h\x1b[?25l"
ALT_OUT = "\x1b[?25h\x1b[?1049l"

TUNE_FIELDS = [(name, default) for name, _, default, _, _ in STYLES] + [
    (NESTED[0], NESTED[2])
]

# Four colours that share one paragraph: a heading, a quoted passage, a link,
# and the emphasis inside that quote. Only the gaps between them matter — the
# heading has to outrank body text, the quote has to sit under it, and the link
# needs a hue neither of them is using — so they are picked as sets, not one at
# a time. All tuned against a near-black background.
SCHEMES = [
    ("forest", {
        "bold": "78;212;112", "italic": "98;131;157",
        "underline": "12;177;237", "quotebold": "inherit",
    }),
    ("terafox", {
        "bold": "161;205;216", "italic": "106;140;140",
        "underline": "90;147;170", "quotebold": "inherit",
    }),
    ("mono", {
        "bold": "232;236;236", "italic": "122;134;138",
        "underline": "168;192;200", "quotebold": "inherit",
    }),
    ("ember", {
        "bold": "245;176;98", "italic": "152;126;110",
        "underline": "110;175;195", "quotebold": "inherit",
    }),
    ("ink", {
        "bold": "155;175;240", "italic": "108;120;152",
        "underline": "116;192;232", "quotebold": "inherit",
    }),
    ("orchid", {
        "bold": "129;224;148", "italic": "168;160;190",
        "underline": "12;177;237", "quotebold": "205;130;155",
    }),
    # Lifted from the themes installed in the Obsidian vault, so a transcript
    # sits next to notes without a clash. Accents are the themes' own values;
    # the quote colour is the one role that gets adjusted, because a comment
    # grey chosen to recede behind an editor background is too dark to read a
    # whole quoted paragraph in against a terminal.
    ("tokyonight", {
        "bold": "122;162;247", "italic": "108;118;160",
        "underline": "125;207;255", "quotebold": "187;154;247",
    }),
    ("everforest", {
        "bold": "167;192;128", "italic": "133;146;137",
        "underline": "127;187;179", "quotebold": "230;152;117",
    }),
    ("kanagawa", {
        "bold": "250;189;47", "italic": "146;131;116",
        "underline": "131;165;152", "quotebold": "254;128;25",
    }),
    ("gruvbox", {
        "bold": "231;138;78", "italic": "146;131;116",
        "underline": "125;174;163", "quotebold": "inherit",
    }),
    ("onedark", {
        "bold": "152;195;121", "italic": "128;132;140",
        "underline": "97;175;239", "quotebold": "229;192;123",
    }),
    ("oscura", {
        "bold": "230;230;230", "italic": "110;112;122",
        "underline": "71;159;250", "quotebold": "inherit",
    }),
    ("things", {
        "bold": "68;207;110", "italic": "130;140;155",
        "underline": "2;122;255", "quotebold": "168;130;255",
    }),
    ("cybertron", {
        "bold": "199;196;0", "italic": "130;150;158",
        "underline": "49;156;180", "quotebold": "93;188;210",
    }),
]

# Where a scheme came from, shown in the gallery so the Obsidian-derived ones
# are recognisable as the themes they are.
SCHEME_NOTE = {
    "forest": "the original defaults",
    "terafox": "your tmux theme",
    "orchid": "your own bold green",
    "tokyonight": "obsidian: Tokyo Night (active)",
    "everforest": "obsidian: Everforest",
    "kanagawa": "obsidian: Kanagawa",
    "gruvbox": "obsidian: Material Gruvbox",
    "onedark": "obsidian: Atom",
    "oscura": "obsidian: Oscura",
    "things": "obsidian: Things",
    "cybertron": "obsidian: Cybertron",
}

ANSI16 = [
    (0, 0, 0), (128, 0, 0), (0, 128, 0), (128, 128, 0),
    (0, 0, 128), (128, 0, 128), (0, 128, 128), (192, 192, 192),
    (128, 128, 128), (255, 0, 0), (0, 255, 0), (255, 255, 0),
    (0, 0, 255), (255, 0, 255), (0, 255, 255), (255, 255, 255),
]
CUBE = (0, 95, 135, 175, 215, 255)


def xterm_rgb(index):
    if index < 16:
        return ANSI16[index]
    if index < 232:
        index -= 16
        return (CUBE[index // 36], CUBE[(index // 6) % 6], CUBE[index % 6])
    level = 8 + (index - 232) * 10
    return (level, level, level)


def spec_rgb(spec):
    """(r, g, b) for a spec, or None when it carries no colour of its own."""
    s = spec.strip().lower()
    if s in ("off", "none", "inherit", ""):
        return None
    match = re.fullmatch(r"(\d{1,3})[;,](\d{1,3})[;,](\d{1,3})", s)
    if match:
        return tuple(min(255, int(v)) for v in match.groups())
    if re.fullmatch(r"\d{1,3}", s):
        return xterm_rgb(min(255, int(s)))
    return None


def fg(rgb):
    return "" if rgb is None else "\x1b[38;2;%d;%d;%dm" % rgb


def preview_lines(specs):
    """The sample transcript, styled exactly as the Translator would style it."""
    bold = fg(spec_rgb(specs["bold"]))
    ital = fg(spec_rgb(specs["italic"]))
    und = fg(spec_rgb(specs["underline"]))
    quote = fg(spec_rgb(specs["quotebold"])) or ital
    r = "\x1b[0m"

    return [
        f"\x1b[1m{bold}Two pushbacks, one ask{r}",
        "Body text, plain and unstyled.",
        "",
        f"\x1b[2m▌{r} \x1b[3m{ital}Good pushback. On \x1b[1m{quote}at risk{r}"
        f"\x1b[3m{ital} you're right.{r}",
        f"\x1b[2m▌{r} \x1b[3m{ital}Nested emphasis keeps the quote colour.{r}",
        "",
        f"See the \x1b[4m{und}docs{r} for detail.",
        f"\x1b[3m{ital}An aside, italic, outside any quote.{r}",
    ]


def scheme_name(specs):
    """Name of the scheme these specs match exactly, else None."""
    for name, preset in SCHEMES:
        if all(specs.get(k, "").strip().lower() == v for k, v in preset.items()):
            return name
    return None


def scheme_swatch(preset):
    cells = []
    for field, _ in TUNE_FIELDS:
        rgb = spec_rgb(preset[field]) or spec_rgb(preset["italic"])
        cells.append(f"{fg(rgb)}███\x1b[0m")
    return "".join(cells)


def bar(value, width=20):
    filled = round(value / 255 * width)
    return "█" * filled + "░" * (width - filled)


def render(specs, sel, channel, dirty):
    name, default = TUNE_FIELDS[sel]
    rgb = spec_rgb(specs[name])
    current = scheme_name(specs)
    label = current or "custom"
    out = [
        "\x1b[1mclaude-color\x1b[0m \x1b[2m— live tuner\x1b[0m",
        f"\x1b[2mscheme\x1b[0m {label}  \x1b[2m[ ] cycle · s gallery\x1b[0m",
        "",
    ]

    for i, (field, _) in enumerate(TUNE_FIELDS):
        spec = specs[field]
        swatch = f"{fg(spec_rgb(spec))}██████\x1b[0m" if spec_rgb(spec) else "\x1b[2m──────\x1b[0m"
        marker = "\x1b[1m▸\x1b[0m" if i == sel else " "
        row = f" {marker} {field:<10} {spec:>13}  {swatch}"
        out.append(row if i == sel else f"\x1b[2m{row}\x1b[0m")

    out.append("")
    if rgb is None:
        out.append(f"\x1b[2m   {name} carries no colour — press o to give it one\x1b[0m")
        out.extend(["", ""])
    else:
        for c, label in enumerate("RGB"):
            mark = "\x1b[1m›\x1b[0m" if c == channel else " "
            tint = fg(tuple(rgb[j] if j == c else 40 for j in range(3)))
            out.append(f"  {mark} {label} {tint}{bar(rgb[c])}\x1b[0m {rgb[c]:>3}")

    out.extend(["", "\x1b[2m── preview ───────────────────────────────────────────\x1b[0m", ""])
    out.extend("  " + line for line in preview_lines(specs))

    state = "\x1b[2mwrote " + CONFIG + "\x1b[0m" if dirty else "\x1b[2mno changes yet\x1b[0m"
    out.extend([
        "",
        "\x1b[2m↑↓\x1b[0m field   \x1b[2m←→\x1b[0m nudge ±1   \x1b[2mHL\x1b[0m ±16   "
        "\x1b[2mtab\x1b[0m channel   \x1b[2mp\x1b[0m palette",
        "\x1b[2m[ ]\x1b[0m cycle scheme   \x1b[2ms\x1b[0m gallery   \x1b[2mo\x1b[0m off/inherit   "
        "\x1b[2m0\x1b[0m default   \x1b[2mu\x1b[0m undo   \x1b[2mq\x1b[0m quit",
        state,
    ])
    return out


def paint(lines):
    frame = "\x1b[H" + "\r\n".join(line + "\x1b[K" for line in lines) + "\x1b[J"
    sys.stdout.write(frame)
    sys.stdout.flush()


def read_key(fd):
    ch = os.read(fd, 1)
    if ch != b"\x1b":
        return ch.decode("utf-8", "replace")

    seq = b""
    while len(seq) < 8:
        ready, _, _ = select.select([fd], [], [], 0.03)
        if not ready:
            break
        seq += os.read(fd, 1)
        if seq[-1:].isalpha() or seq[-1:] == b"~":
            break
    return {b"[A": "up", b"[B": "down", b"[C": "right", b"[D": "left"}.get(seq, "esc")


def pick_palette(fd, start):
    """256-colour grid overlay. Returns an index, or None if cancelled."""
    pos = start if isinstance(start, int) else 0
    while True:
        out = ["\x1b[1mpalette\x1b[0m \x1b[2m— ↑↓←→ move, enter pick, esc cancel\x1b[0m", ""]
        for row in range(16):
            cells = []
            for col in range(16):
                i = row * 16 + col
                mark = "\x1b[7m" if i == pos else ""
                cells.append(f"{mark}\x1b[38;5;{i}m███\x1b[0m")
            out.append("  " + "".join(cells))

        r, g, b = xterm_rgb(pos)
        out.extend(["", f"  {fg((r, g, b))}██████\x1b[0m  index {pos}   →  {r};{g};{b}"])
        paint(out)

        key = read_key(fd)
        if key in ("q", "esc"):
            return None
        if key in ("\r", "\n"):
            return pos
        pos = {
            "up": max(0, pos - 16), "down": min(255, pos + 16),
            "left": max(0, pos - 1), "right": min(255, pos + 1),
        }.get(key, pos)


def current_specs():
    """Every field resolved through config, then env, then built-in default."""
    cfg = read_config()
    specs = {
        name: cfg.get(name, os.environ.get(env, default))
        for name, env, default, *_ in STYLES
    }
    specs[NESTED[0]] = cfg.get(NESTED[0], os.environ.get(NESTED[1], NESTED[2]))
    return specs


def cmd_schemes():
    active = scheme_name(current_specs())
    for name, preset in SCHEMES:
        mark = "\x1b[1m▸\x1b[0m" if name == active else " "
        note = SCHEME_NOTE.get(name, "")
        tag = "  \x1b[2m(current)\x1b[0m" if name == active else f"  \x1b[2m{note}\x1b[0m"
        sample = preview_lines(preset)
        print(f" {mark} \x1b[1m{name:<11}\x1b[0m {scheme_swatch(preset)}{tag}")
        for line in (sample[0], sample[3], sample[6]):
            print(f"     {line}")
        print()
    print("\x1b[2mapply\x1b[0m  claude-color --scheme <name>"
          "     \x1b[2mtune\x1b[0m  claude-color --tune")


def apply_scheme(name):
    preset = dict(SCHEMES).get(name)
    if preset is None:
        have = ", ".join(n for n, _ in SCHEMES)
        sys.exit(f"claude-color: no scheme {name!r} (have {have})")

    cfg = read_config()
    cfg.update(preset)
    write_config(cfg)
    print(f"applied {name}")
    for field, value in preset.items():
        print(f"  {field}={value}")
    print("open claude-color sessions pick this up within a second")


def pick_scheme(fd, active):
    """Scheme gallery overlay. Returns a preset, or None if cancelled."""
    names = [name for name, _ in SCHEMES]
    pos = names.index(active) if active in names else 0
    while True:
        out = ["\x1b[1mschemes\x1b[0m \x1b[2m— ↑↓ move, enter apply, esc cancel\x1b[0m", ""]
        for i, (name, preset) in enumerate(SCHEMES):
            mark = "\x1b[1m▸\x1b[0m" if i == pos else " "
            row = (f" {mark} {name:<11} {scheme_swatch(preset)}  "
                   f"\x1b[2m{SCHEME_NOTE.get(name, '')}\x1b[0m")
            out.append(row)

        out.extend(["", "\x1b[2m── preview ──────────────────────────────\x1b[0m", ""])
        out.extend("  " + line for line in preview_lines(SCHEMES[pos][1]))
        paint(out)

        key = read_key(fd)
        if key in ("q", "esc"):
            return None
        if key in ("\r", "\n"):
            return SCHEMES[pos][1]
        if key in ("up", "k"):
            pos = (pos - 1) % len(SCHEMES)
        elif key in ("down", "j"):
            pos = (pos + 1) % len(SCHEMES)


def cmd_tune():
    if not sys.stdin.isatty():
        sys.exit("claude-color: --tune needs a terminal")

    specs = current_specs()
    sel, channel, dirty = 0, 0, False
    history = []
    fd = sys.stdin.fileno()
    old_attrs = termios.tcgetattr(fd)

    def save():
        merged = read_config()
        merged.update(specs)
        write_config(merged)

    def stage(**changes):
        """One undo step, however many fields it touches."""
        history.append(dict(specs))
        specs.update(changes)
        save()

    def cycle_scheme(step):
        current = scheme_name(specs)
        names = [name for name, _ in SCHEMES]
        index = names.index(current) + step if current else (0 if step > 0 else -1)
        stage(**SCHEMES[index % len(SCHEMES)][1])

    sys.stdout.write(ALT_IN)
    tty.setraw(fd)
    try:
        while True:
            paint(render(specs, sel, channel, dirty))
            key = read_key(fd)
            name, default = TUNE_FIELDS[sel]
            rgb = spec_rgb(specs[name])

            if key in ("q", "esc", "\x03"):
                break
            elif key in ("up", "k"):
                sel = (sel - 1) % len(TUNE_FIELDS)
            elif key in ("down", "j"):
                sel = (sel + 1) % len(TUNE_FIELDS)
            elif key == "\t":
                channel = (channel + 1) % 3
            elif key in ("left", "right", "h", "l", "H", "L") and rgb:
                step = 16 if key in ("H", "L") else 1
                step = -step if key in ("left", "h", "H") else step
                shifted = list(rgb)
                shifted[channel] = max(0, min(255, shifted[channel] + step))
                stage(**{name: "%d;%d;%d" % tuple(shifted)})
                dirty = True
            elif key in ("[", "]"):
                cycle_scheme(1 if key == "]" else -1)
                dirty = True
            elif key == "s":
                preset = pick_scheme(fd, scheme_name(specs))
                if preset:
                    stage(**preset)
                    dirty = True
            elif key == "o":
                blank = "inherit" if name == NESTED[0] else "off"
                fallback = "%d;%d;%d" % (spec_rgb(specs["italic"]) or (128, 128, 128))
                stage(**{name: blank if rgb else fallback})
                dirty = True
            elif key == "0":
                stage(**{name: default})
                dirty = True
            elif key == "p":
                picked = pick_palette(fd, 0)
                if picked is not None:
                    stage(**{name: "%d;%d;%d" % xterm_rgb(picked)})
                    dirty = True
            elif key == "u" and history:
                specs.clear()
                specs.update(history.pop())
                save()
                dirty = True
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_attrs)
        sys.stdout.write(ALT_OUT)
        sys.stdout.flush()

    for field, value in specs.items():
        print(f"  {field}={value}")
    print("open claude-color sessions pick this up within a second")


class Translator:
    """Rewrites SGR sequences, holding back a partial escape at chunk end.

    Keeps a stack of the styles it has opened, because what a code means
    depends on what is already open: bold inside a blockquote is emphasis
    rather than a heading, and any style ending inside another one has to fall
    back to that one's colour instead of the default foreground.
    """

    def __init__(self, colors):
        self.colors = colors
        self.carry = b""
        self.stack = []
        self.link = False

    def apply(self, colors):
        self.colors = colors

    def _in_italic(self):
        return any(name == "italic" for name, _ in self.stack)

    def _restore(self):
        """Colour to fall back to when the innermost style ends."""
        for _, color in reversed(self.stack):
            if color:
                return b";" + color
        return b";39"

    def _hyperlink(self, match):
        # Underline is the one thing a link should always have, whether or not
        # Claude Code styled it. The colour follows the underline setting; with
        # underline=off the link still gets its rule, just no hue.
        color = self.colors.get("underline")
        if match.group(1):
            self.link = True
            self.stack.append(("underline", color))
            on = b"\x1b[4" + (b";" + color if color else b"") + b"m"
            return match.group(0) + on

        if not self.link:
            return match.group(0)

        self.link = False
        for i in range(len(self.stack) - 1, -1, -1):
            if self.stack[i][0] == "underline":
                del self.stack[i]
                break
        return b"\x1b[24" + self._restore() + b"m" + match.group(0)

    def _sgr(self, match, params):
        # A full reset closes everything, links included.
        if params in (b"", b"0"):
            self.stack = []
            self.link = False
            return match.group(0)

        name = STYLE_ON.get(params)
        if name:
            color = self.colors.get(name)
            if name == "bold" and self._in_italic():
                color = self.colors.get("quotebold")

            self.stack.append((name, color))
            if color is None:
                return match.group(0)
            return b"\x1b[" + params + b";" + color + b"m"

        name = STYLE_OFF.get(params)
        if name:
            closing = None
            for i in range(len(self.stack) - 1, -1, -1):
                if self.stack[i][0] == name:
                    closing = self.stack.pop(i)
                    break

            # Leave the code alone when nothing coloured is involved, so a
            # colour Claude Code set itself is never reset out from under it.
            restore = self._restore()
            if (closing is None or closing[1] is None) and restore == b";39":
                return match.group(0)
            return b"\x1b[" + params + restore + b"m"

        return match.group(0)

    def _token(self, match):
        if match.group(1) is not None:
            return self._hyperlink(match)
        return self._sgr(match, match.group(2))

    def _hold(self, data):
        """Index to carry from: an escape sequence split across chunks."""
        start = data.rfind(b"\x1b]")
        if start != -1 and not ST.search(data, start + 2):
            return start

        match = PARTIAL.search(data)
        return match.start() if match else None

    def feed(self, data):
        data = self.carry + data
        hold = self._hold(data)
        if hold is None:
            self.carry = b""
        else:
            self.carry = data[hold:]
            data = data[:hold]
        return TOKEN.sub(self._token, data)


def copy_winsize(master_fd):
    try:
        size = fcntl.ioctl(sys.stdin.fileno(), termios.TIOCGWINSZ, b"\0" * 8)
        fcntl.ioctl(master_fd, termios.TIOCSWINSZ, size)
    except OSError:
        pass


def main():
    args = sys.argv[1:]
    if args and args[0] == "--palette":
        print_palette()
        return
    if args and args[0] == "--tune":
        cmd_tune()
        return
    if args and args[0] == "--schemes":
        cmd_schemes()
        return
    if args and args[0] == "--scheme":
        if len(args) < 2:
            sys.exit("claude-color: --scheme needs a name (see --schemes)")
        apply_scheme(args[1])
        return
    if args and args[0] == "--set":
        try:
            cmd_set(args[1:])
        except ValueError as err:
            sys.exit(f"claude-color: {err}")
        return

    try:
        colors = build_colors()
    except ValueError as err:
        sys.exit(f"claude-color: {err}")

    cmd = ["claude", *args]
    pid, master_fd = pty.fork()
    if pid == 0:
        os.execvp(cmd[0], cmd)

    interactive = sys.stdin.isatty()
    old_attrs = None
    if interactive:
        copy_winsize(master_fd)
        signal.signal(signal.SIGWINCH, lambda *_: copy_winsize(master_fd))
        old_attrs = termios.tcgetattr(sys.stdin.fileno())
        tty.setraw(sys.stdin.fileno())

    translator = Translator(colors)
    stdin_fd = sys.stdin.fileno()
    stdin_open = True
    seen_mtime = config_mtime()
    next_check = time.monotonic() + 0.5
    try:
        while True:
            fds = [master_fd] + ([stdin_fd] if stdin_open else [])
            try:
                ready, _, _ = select.select(fds, [], [], 1.0)
            except InterruptedError:
                continue

            now = time.monotonic()
            if now >= next_check:
                next_check = now + 0.5
                mtime = config_mtime()
                if mtime != seen_mtime:
                    seen_mtime = mtime
                    try:
                        translator.apply(build_colors())
                    except ValueError:
                        pass  # bad edit: keep the old colors, never kill the session

            if master_fd in ready:
                try:
                    data = os.read(master_fd, 65536)
                except OSError:
                    break
                if not data:
                    break
                os.write(sys.stdout.fileno(), translator.feed(data))
            if stdin_fd in ready:
                data = os.read(stdin_fd, 65536)
                if not data:
                    stdin_open = False
                    continue
                os.write(master_fd, data)
    finally:
        if old_attrs is not None:
            termios.tcsetattr(stdin_fd, termios.TCSADRAIN, old_attrs)
        os.close(master_fd)

    _, status = os.waitpid(pid, 0)
    sys.exit(os.waitstatus_to_exitcode(status))


if __name__ == "__main__":
    main()
